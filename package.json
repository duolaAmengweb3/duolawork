{
  "name": "duolawork",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:server": "node --import tsx src/server/index.ts",
    "desktop": "node scripts/run-desktop.mjs",
    "build": "node scripts/build-app.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify:live": "node --import tsx tests/live-codex-gemini2vps.ts --live",
    "package:mac": "node scripts/package-mac.mjs",
    "package:dmg": "node scripts/package-dmg.mjs",
    "activate:local": "node scripts/activate-local.mjs",
    "deliver:local": "npm run build && npm test && npm run package:mac && npm run activate:local"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "croner": "^11.0.1",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^45.5.0",
    "playwright": "^1.52.0",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
