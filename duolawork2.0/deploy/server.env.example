# DuolaWork 2.0 Cloud Control Plane Environment Template
# Copy to /etc/duolawork/server.env with `chmod 0600`

DUOLAWORK_CLOUD_MODE=1
DUOLAWORK_HOST=127.0.0.1
DUOLAWORK_V2_PORT=8780
DUOLAWORK_V2_DB=/var/lib/duolawork/duolawork-v2.sqlite
DUOLAWORK_FILES_DIR=/var/lib/duolawork/files
DUOLAWORK_LOCK_FILE=/var/lib/duolawork/server.lock
DUOLAWORK_PUBLIC_ORIGIN=https://work.manyaitool.com

# Generate hash via:
# node -e "import('./dist/server/app.mjs').then(m => console.log(m.hashPassword('YOUR_STRONG_PASSWORD')))"
DUOLAWORK_AUTH_REQUIRED=1
DUOLAWORK_ADMIN_PASSWORD_HASH=

# 32-byte random secret for encrypting settings stored in SQLite
DUOLAWORK_MASTER_KEY=

# Optional DuolaBase MCP connection (never exposed to browser or nodes)
DUOLABASE_MCP_URL=https://duolabase.manyaitool.com/mcp
DUOLABASE_MCP_TOKEN=
