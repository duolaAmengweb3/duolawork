[Unit]
Description=DuolaWork 2.0 SQLite WAL Hot Backup

[Service]
Type=oneshot
User=duolawork
Group=duolawork
ExecStart=/bin/sh -c 'mkdir -p /var/lib/duolawork/backups && sqlite3 /var/lib/duolawork/duolawork-v2.sqlite ".backup /var/lib/duolawork/backups/dw2-$(date +%%F-%%H%%M).sqlite" && find /var/lib/duolawork/backups -name "dw2-*.sqlite" -mtime +14 -delete'
